{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeamNG.ModManager",
  "version": "0.7.0",
  "identifier": "com.beamng.fastmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BeamNG.ModManager",
        "width": 1380,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#161922"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
